#!/bin/bash
# generated by scripts/i4_cases.py.  Optional: INIT_FROM=<case dir> maps that case's latest solution as the
# initial field (pre-approved adjustment (c)); otherwise uniform free stream.
cd "${0%/*}" || exit 1
source /usr/lib/openfoam/openfoam2512/etc/bashrc >/dev/null 2>&1
REPO=$(git rev-parse --show-toplevel 2>/dev/null)
{ echo "commit $(git -C "$REPO" rev-parse HEAD 2>/dev/null)";
   echo "dirty_files $(git -C "$REPO" status --porcelain --untracked-files=no 2>/dev/null | wc -l)";
   echo "start $(date -Is)"; echo "host $(hostname)"; echo "np 4"; echo "init_from ${INIT_FROM:-uniform}"; } > run_info.txt
foamListTimes -rm -noZero > /dev/null 2>&1; rm -rf 0 postProcessing processor* && cp -r 0.orig 0
blockMesh > log.blockMesh 2>&1 || exit 1
checkMesh > log.checkMesh 2>&1 || exit 1
postProcess -func writeCellCentres -time 0 > log.cc 2>&1 || exit 1
if [ -n "$INIT_FROM" ]; then
    mapFields "$INIT_FROM" -sourceTime latestTime -consistent -mapMethod cellPointInterpolate > log.mapFields 2>&1 || exit 1
fi
decomposePar > log.decomposePar 2>&1 || exit 1
/usr/bin/time -v mpirun -np 4 hisa -parallel > log.solver 2> log.time
rc=$?
reconstructPar > log.reconstructPar 2>&1 || rc=90
tail -n 300 log.solver > log.solver.tail
echo "end $(date -Is) rc $rc" >> run_info.txt
exit $rc
